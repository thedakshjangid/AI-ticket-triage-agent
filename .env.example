# Copy to .env and fill in. Never commit .env.

# Which model runs the agent: mock (offline, no key needed), openai or anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Shared secret for signing webhook requests, and the key for the read API
WEBHOOK_SECRET=change-me-long-random-string
API_KEY=change-me-another-random-string
